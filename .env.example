# Copy this file to .env.local and fill in the values.

# --- Database ----------------------------------------------------------------
# On Railway: set this on the app service to ${{Postgres.DATABASE_URL}}
# Locally:    the Postgres service's PUBLIC url, or any local instance, e.g.
#             postgres://postgres:postgres@localhost:5432/gmaps
DATABASE_URL=

# --- Google Places -----------------------------------------------------------
# API key with "Places API (New)" enabled.
# https://console.cloud.google.com/google/maps-apis/credentials
#
# Reading a shared list works without this — names, addresses and coordinates
# come from the list itself. The key is what adds hours, phone, website,
# rating, price and category.
GOOGLE_MAPS_API_KEY=

# --- Map ----------------------------------------------------------------------
# A SECOND key, for the Maps JavaScript API. Unlike the key above, this one is
# sent to every visitor's browser, so restrict it:
#   Application restrictions → Websites → your Railway domain and
#   http://localhost:3000/*
#   API restrictions         → Maps JavaScript API only
# Don't reuse GOOGLE_MAPS_API_KEY here: a key restricted to websites can't make
# the server's Places calls, and an unrestricted key in a page can be lifted
# and billed to you.
GOOGLE_MAPS_BROWSER_KEY=

# Optional. Advanced markers need a Map ID; DEMO_MAP_ID is used if unset.
# GOOGLE_MAPS_MAP_ID=
