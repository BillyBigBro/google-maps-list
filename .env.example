# Copy this file to .env.local and fill in the values.

# Postgres connection string.
# On Railway: add the Postgres plugin and reference it as ${{Postgres.DATABASE_URL}}
#             in your service variables — Railway injects it automatically.
# Locally:    point this at any Postgres instance, e.g.
#             postgres://postgres:postgres@localhost:5432/gmaps
DATABASE_URL=

# Google Maps Platform API key with the "Places API (New)" enabled.
# https://console.cloud.google.com/google/maps-apis/credentials
#
# Without this the app still imports and organizes lists; the Google-sourced
# columns (hours, phone, website, rating, category) just stay empty.
GOOGLE_MAPS_API_KEY=
